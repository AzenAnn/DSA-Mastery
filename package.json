    "@mzwing/oxc-config": "0.1.6",
    "@playwright/test": "^1.62.1",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "22.20.2",
    "gray-matter": "4.0.3",
    "knip": "6.35.1",
    "markdown-it": "14.3.2",
    "markdown-it-mathjax3": "4.3.2",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "7.0.2001",
    "shiki": "4.4.3",
    "typescript": "npm:typescript-native-bridge@6.0.3-bridge.17.tsgo.7.0.2",
    "vite": "8.3.0",
    "vitepress": "2.0.0-alpha.20",
    "vitepress-plugin-diagrams": "1.3.1",
