{
  "name": "dsa-mastery",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.4.2+sha512.08adc6613180275c7c9edada39dcf08c9c61ad4e7eaf330a4f3461f102b0f907423454d117f98e72d47fef0616070644d7bffc973a6a57f5090a6d7c368b07c9",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vitepress dev .",
    "dev:vitepress": "pnpm run dev",
    "build": "vitepress build .",
    "build:vitepress": "pnpm run build",
    "preview": "vitepress preview .",
    "preview:vitepress": "pnpm run preview",
    "validate": "pnpm run validate:content && pnpm run typecheck && pnpm run lint",
    "validate:content": "node scripts/validate-content.mjs",
    "lab:new": "node tools/lab/cli.mjs new",
    "lab:locate": "node tools/lab/cli.mjs locate",
    "lab:doctor": "node tools/lab/cli.mjs doctor",
    "lab:validate": "node tools/lab/cli.mjs validate",
    "lab:build": "node tools/lab/cli.mjs build",
    "lab:run": "node tools/lab/cli.mjs run",
    "lab:interactive": "node tools/lab/cli.mjs interactive",
    "lab:score": "node tools/lab/cli.mjs score",
    "lab:verify": "node tools/lab/cli.mjs verify",
    "lab:refresh-expected": "node tools/lab/cli.mjs refresh-expected",
    "lab:pack": "node tools/lab/cli.mjs pack",
    "lab:clean": "node tools/lab/cli.mjs clean",
    "setup": "node scripts/bootstrap/setup.mjs",
    "setup:check": "node scripts/bootstrap/setup.mjs --check-only",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "check:site": "node scripts/check-built-site.mjs",
    "test:discovery": "vitest run tests/content-discovery.test.mjs",
    "test:tree-demos": "vitest run tests/tree-demos.test.mjs",
    "test:bootstrap": "vitest run tests/bootstrap.test.mjs",
    "test:lab-tools": "vitest run tests/lab-tools.test.mjs tests/lab-terminal.test.mjs tests/project-state.test.mjs",
    "test:project-engineering": "vitest run tests/project-engineering.test.mjs",
    "test:lab-docs": "vitest run tests/lab-docs.test.mjs",
    "test:ch07": "vitest run tests/ch07-exercises.test.mjs",
    "test:lab-golden": "vitest run tests/lab-golden.test.mjs",
    "test:lab-make": "vitest run tests/lab-make.test.mjs",
    "test": "pnpm run validate && pnpm run test:tree-demos && pnpm run test:bootstrap && pnpm run test:lab-tools && pnpm run test:lab-docs && pnpm run test:ch07 && pnpm run test:discovery && pnpm run build && pnpm run check:site",
    "test:pages": "playwright test",
    "lint": "oxlint --disable-nested-config",
    "lint:fix": "oxlint --disable-nested-config --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "knip": "knip"
  },
  "devDependencies": {
    "@lucide/vue": "1.46.0",
    "@mdit/plugin-container": "1.0.2",
    "@mdit/plugin-mark": "1.0.1",
