{
  "name": "dsa-mastery",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vitepress dev . --host 127.0.0.1",
    "dev:vitepress": "pnpm run dev",
    "build": "vitepress build .",
    "build:vitepress": "pnpm run build",
    "preview": "vitepress preview . --host 127.0.0.1",
    "preview:vitepress": "pnpm run preview",
    "validate": "pnpm run validate:content && pnpm run typecheck && pnpm run lint",
    "validate:content": "node scripts/validate-content.mjs",
    "lab:new": "node tools/lab/cli.mjs new",
    "lab:locate": "node tools/lab/cli.mjs locate",
    "lab:doctor": "node tools/lab/cli.mjs doctor",
    "lab:validate": "node tools/lab/cli.mjs validate",
    "lab:build": "node tools/lab/cli.mjs build",
    "lab:run": "node tools/lab/cli.mjs run",
    "lab:interactive": "node tools/lab/cli.mjs interactive",
    "lab:score": "node tools/lab/cli.mjs score",
    "lab:verify": "node tools/lab/cli.mjs verify",
    "lab:refresh-expected": "node tools/lab/cli.mjs refresh-expected",
    "lab:pack": "node tools/lab/cli.mjs pack",
    "lab:clean": "node tools/lab/cli.mjs clean",
    "setup": "node scripts/bootstrap/setup.mjs",
    "setup:check": "node scripts/bootstrap/setup.mjs --check-only",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "check:site": "node scripts/check-built-site.mjs",
    "test:discovery": "node scripts/test-content-discovery.mjs",
    "test:bootstrap": "node --test tests/bootstrap.test.mjs",
    "test:lab-tools": "node --test tests/lab-tools.test.mjs tests/lab-terminal.test.mjs",
    "test:lab-docs": "node scripts/validate-lab-docs.mjs",
    "test:lab-golden": "node scripts/verify-golden-labs.mjs",
    "test:lab-make": "node scripts/verify-make-consistency.mjs",
    "test": "pnpm run validate && pnpm run test:bootstrap && pnpm run test:lab-tools && pnpm run test:lab-docs && pnpm run test:discovery && pnpm run build && pnpm run check:site",
    "test:pages": "playwright test",
    "lint": "eslint \".vitepress/**/*.{ts,vue}\" \"scripts/**/*.mjs\" \"tools/lab/**/*.mjs\" \"tests/**/*.mjs\" playwright.config.mjs eslint.config.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@lucide/vue": "1.31.0",
    "@mdit/plugin-container": "1.0.2",
    "@mdit/plugin-mark": "1.0.1",
    "@mdit/plugin-tasklist": "1.0.2",
    "@playwright/test": "^1.62.1",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "22.19.19",
    "eslint": "9.39.4",
    "eslint-plugin-vue": "10.10.0",
    "globals": "16.4.0",
    "gray-matter": "4.0.3",
    "markdown-it": "14.3.0",
    "markdown-it-mathjax3": "4.3.2",
    "shiki": "2.5.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vite": "5.4.21",
    "vitepress": "1.6.4",
    "vitepress-plugin-diagrams": "1.3.1",
    "vue": "3.5.41",
    "vue-tsc": "3.3.9"
  },
  "type": "module"
}
