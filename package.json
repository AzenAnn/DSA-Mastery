{
  "name": "dsa-mastery",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vitepress dev . --host 127.0.0.1",
    "dev:vitepress": "npm run dev",
    "build": "vitepress build .",
    "build:vitepress": "npm run build",
    "preview": "vitepress preview . --host 127.0.0.1",
    "preview:vitepress": "npm run preview",
    "validate": "npm run validate:content && npm run typecheck && npm run lint",
    "validate:content": "node scripts/validate-content.mjs",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "check:site": "node scripts/check-built-site.mjs",
    "test:discovery": "node scripts/test-content-discovery.mjs",
    "test": "npm run validate && npm run test:discovery && npm run build && npm run check:site",
    "test:pages": "playwright test",
    "lint": "eslint \".vitepress/**/*.{ts,vue}\" scripts/validate-content.mjs scripts/check-built-site.mjs scripts/test-content-discovery.mjs tests/pages-navigation.spec.mjs playwright.config.mjs eslint.config.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@lucide/vue": "1.31.0",
    "@mdit/plugin-tasklist": "1.0.2",
    "@playwright/test": "^1.62.1",
    "@types/node": "22.19.19",
    "eslint": "9.39.4",
    "eslint-plugin-vue": "10.10.0",
    "globals": "16.4.0",
    "gray-matter": "4.0.3",
    "markdown-it": "14.3.0",
    "markdown-it-mathjax3": "4.3.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vitepress": "1.6.4",
    "vue": "3.5.41",
    "vue-tsc": "3.3.9"
  },
  "type": "module"
}
