{
  "name": "dsa-mastery",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vitepress dev .",
    "build": "vitepress build .",
    "preview": "vitepress preview .",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "knip": "knip",
    "lab": "node packages/lab-cli/dist/cli.js",
    "setup-env": "node packages/bootstrap/dist/setup.js",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@dsa/course-index": "workspace:*",
    "@dsa/lab-cli": "workspace:*",
    "@dsa/lab-core": "workspace:*",
    "@dsa/lab-runner": "workspace:*"
  },
  "devDependencies": {
    "@dsa/course-authoring": "workspace:*",
    "@dsa/lab-testkit": "workspace:*",
    "@lucide/vue": "1.47.0",
    "@mdit/plugin-container": "1.0.2",
    "@mdit/plugin-mark": "1.0.1",
    "@mzwing/oxc-config": "0.1.6",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "22.20.2",
    "gray-matter": "4.0.3",
    "knip": "6.37.0",
    "markdown-it": "14.3.2",
    "markdown-it-mathjax3": "4.3.2",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "7.0.2002",
    "playwright": "1.63.0",
    "shiki": "4.4.3",
    "simple-git-hooks": "2.14.0",
    "typescript": "npm:typescript-native-bridge@6.0.3-bridge.17.tsgo.7.0.2",
    "vite": "8.3.0",
    "vitepress": "2.0.0-alpha.20",
    "vitepress-plugin-diagrams": "1.3.1",
    "vitest": "5.0.1",
    "vue": "3.5.43",
    "vue-tsc": "3.3.11"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm -r build && git add packages/*/dist"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@12.5.1+sha512.e3f305bc784a2bc89f5ad3b6138889470fae8d2af5f36b61216ec91c2c3d64089775f9de38aac331044ea40f245cb0d5666392dfdf65824e1907ef6a2c62de5f"
