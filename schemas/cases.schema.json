{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsa-mastery.local/schemas/cases.schema.json",
  "title": "DSA Mastery stdio test cases",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": ["id", "input", "expected", "points"],
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
      "input": { "type": "string", "minLength": 1 },
      "expected": { "type": "string", "minLength": 1 },
      "points": { "type": "integer", "minimum": 1 },
      "tags": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
      "timeMs": { "type": "integer", "minimum": 1 },
      "outputKb": { "type": "integer", "minimum": 1 },
      "compare": {
        "type": "object",
        "required": ["mode"],
        "properties": {
          "mode": { "enum": ["exact", "tokens", "float"] },
          "absTol": { "type": "number", "minimum": 0 },
          "relTol": { "type": "number", "minimum": 0 }
        },
        "additionalProperties": false
      }
    },
    "additionalProperties": false
  }
}
