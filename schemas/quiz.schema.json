{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsa-mastery.local/schemas/quiz.schema.json",
  "title": "DSA Mastery single-choice question set",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": ["id", "stem", "options", "answer", "explanation"],
    "properties": {
      "id": { "type": "string", "minLength": 1 },
      "title": { "type": "string", "minLength": 1 },
      "source": { "type": "string", "minLength": 1 },
      "difficulty": { "type": "string", "minLength": 1 },
      "topics": { "type": "array", "items": { "type": "string", "minLength": 1 } },
      "targetId": { "type": "string", "minLength": 1 },
      "stem": { "type": "string", "minLength": 1 },
      "code": { "type": "string", "minLength": 1 },
      "options": {
        "type": "array",
        "minItems": 4,
        "maxItems": 4,
        "items": { "type": "string", "minLength": 1 }
      },
      "answer": { "type": "integer", "minimum": 0, "maximum": 3 },
      "explanation": { "type": "string", "minLength": 1 },
      "hint": { "type": "string", "minLength": 1 },
      "points": { "type": "integer", "minimum": 1 }
    },
    "additionalProperties": false
  }
}
