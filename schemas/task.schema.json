{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsa-mastery.local/schemas/task.schema.json",
  "title": "DSA Mastery project task",
  "type": "object",
  "required": ["schemaVersion", "kind"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "kind": { "enum": ["stdio", "ctest", "manual"] },
    "targets": {
      "type": "object",
      "required": ["student"],
      "properties": {
        "student": { "$ref": "lab.schema.json#/$defs/target" },
        "solution": { "$ref": "lab.schema.json#/$defs/target" }
      },
      "additionalProperties": false
    },
    "judge": { "$ref": "lab.schema.json#/$defs/judge" },
    "ctest": {
      "type": "object",
      "required": ["tests"],
      "properties": {
        "tests": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "points"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "points": { "type": "integer", "minimum": 1 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "checklist": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "stdio" } }, "required": ["kind"] },
      "then": { "required": ["targets", "judge"] }
    },
    {
      "if": { "properties": { "kind": { "const": "ctest" } }, "required": ["kind"] },
      "then": { "required": ["ctest"] }
    },
    {
      "if": { "properties": { "kind": { "const": "manual" } }, "required": ["kind"] },
      "then": { "required": ["checklist"] }
    }
  ],
  "additionalProperties": false
}
