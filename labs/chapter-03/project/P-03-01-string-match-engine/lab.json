{
  "$schema": "../../../../schemas/lab.schema.json",
  "schemaVersion": 1,
  "type": "project",
  "language": "cpp",
  "toolchain": {
    "standard": "c++17",
    "profile": "course-default"
  },
  "buildSystem": "cmake",
  "tasks": [
    {
      "id": "matcher",
      "path": "tasks/task-01-matcher",
      "weight": 30,
      "kind": "stdio",
      "dependsOn": []
    },
    {
      "id": "engine",
      "path": "tasks/task-02-engine",
      "weight": 50,
      "kind": "ctest",
      "dependsOn": ["matcher"]
    },
    {
      "id": "report",
      "path": "report",
      "weight": 20,
      "kind": "manual",
      "dependsOn": [
        "engine"
      ]
    }
  ]
}
