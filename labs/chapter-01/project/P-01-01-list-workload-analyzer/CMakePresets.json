{
  "version": 6,
  "configurePresets": [
    {
      "name": "student",
      "displayName": "Student implementation",
      "binaryDir": "${sourceDir}/.lab-cache/cmake/student",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_STANDARD": "17",
        "CMAKE_CXX_STANDARD_REQUIRED": "ON",
        "LAB_USE_SOLUTION": "OFF"
      }
    },
    {
      "name": "solution",
      "displayName": "Reference implementation",
      "binaryDir": "${sourceDir}/.lab-cache/cmake/solution",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_STANDARD": "17",
        "CMAKE_CXX_STANDARD_REQUIRED": "ON",
        "LAB_USE_SOLUTION": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "student",
      "configurePreset": "student"
    },
    {
      "name": "solution",
      "configurePreset": "solution"
    }
  ],
  "testPresets": [
    {
      "name": "student",
      "configurePreset": "student",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "solution",
      "configurePreset": "solution",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
