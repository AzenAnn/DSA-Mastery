digraph G {
  graph [bgcolor="white", pad=0.3, nodesep=0.65, ranksep=0.6];
  node [shape=circle, fontname="Arial", style=filled, fillcolor="#e8f3ed", color="#24634a", fontcolor="#153c2e"];
  edge [fontname="Arial", fontsize=12, arrowsize=0.7];
  n2 [label="2"]; n1 [label="1"]; n3 [label="3"];
  n2 -> n1 [label="left / tag 0", color="#24634a"];
  n2 -> n3 [label="right / tag 0", color="#24634a"];
  n1 -> n2 [label="successor / tag 1", style=dashed, color="#91563a", constraint=false];
  n3 -> n2 [label="predecessor / tag 1", style=dashed, color="#91563a", constraint=false];
  zero1 [shape=box, label="0", fillcolor="#f4f5f4"]; zero2 [shape=box, label="0", fillcolor="#f4f5f4"];
  n1 -> zero1 [label="left / tag 1", style=dashed, color="#91563a"];
  n3 -> zero2 [label="right / tag 1", style=dashed, color="#91563a"];
  {rank=same; n1 n3;}
}
