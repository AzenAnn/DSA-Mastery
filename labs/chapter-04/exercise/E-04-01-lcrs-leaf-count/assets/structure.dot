digraph G {
  graph [rankdir=TB, bgcolor="white", pad=0.25, nodesep=0.35, ranksep=0.45];
  node [shape=circle, fontname="Arial", style=filled, fillcolor="#e8f3ed", color="#24634a", fontcolor="#153c2e"];
  edge [color="#24634a", arrowsize=0.7];
  subgraph cluster_tree { label="Ordered tree"; fontname="Arial"; color="#ccd7d0";
    a1 [label="1"]; a2 [label="2"]; a3 [label="3"]; a4 [label="4"]; a5 [label="5"]; a6 [label="6"]; a7 [label="7"];
    a1 -> {a2 a3 a4}; a2 -> {a5 a6}; a4 -> a7; {rank=same; a2 a3 a4;} {rank=same; a5 a6 a7;}
  }
  subgraph cluster_lcrs { label="First child / next sibling"; fontname="Arial"; color="#ccd7d0";
    b1 [label="1"]; b2 [label="2"]; b3 [label="3"]; b4 [label="4"]; b5 [label="5"]; b6 [label="6"]; b7 [label="7"];
    b1 -> b2; b2 -> b5; b4 -> b7;
    b2 -> b3 -> b4 [style=dashed, color="#91563a"]; b5 -> b6 [style=dashed, color="#91563a"];
    {rank=same; b2 b3 b4;} {rank=same; b5 b6 b7;}
  }
}
